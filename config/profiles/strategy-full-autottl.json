{
  "name": "strategy-full-autottl",
  "displayName": "Base (Full automatic TTL)",
  "order": 11,
  "description": "Base with automatic TTL fake and fake split handling across HTTP, TLS and dedicated service traffic.",
  "interception": {
    "tcpOut": "80,443,2053,2083,2087,2096,8443",
    "udpOut": "443,19294-19344,50000-50100"
  },
  "blobs": [
    {
      "name": "sample_discord",
      "path": "assets\\ACTIVE_DISCORD_UDP.bin"
    },
    {
      "name": "sample_stun",
      "path": "assets\\stun.bin"
    },
    {
      "name": "sample_tls",
      "path": "assets\\tls_clienthello_www_google_com.bin"
    }
  ],
  "rules": [
    {
      "name": "discord-autottl",
      "scope": "first",
      "matchGroup": "discord-tls",
      "actions": [
        "--out-range=-d10",
        "--payload=tls_client_hello",
        "--lua-desync=fake:blob=sample_tls:ip_autottl=-2,3-20:ip6_autottl=-2,3-20:tcp_md5",
        "--lua-desync=fakedsplit:pos=1:ip_autottl=-2,3-20:ip6_autottl=-2,3-20:tcp_md5"
      ]
    },
    {
      "name": "whatsapp-autottl",
      "scope": "first",
      "matchGroup": "whatsapp-tls",
      "actions": [
        "--out-range=-d10",
        "--payload=tls_client_hello",
        "--lua-desync=fake:blob=sample_tls:ip_autottl=-2,3-20:ip6_autottl=-2,3-20:tcp_md5",
        "--lua-desync=fakedsplit:pos=1:ip_autottl=-2,3-20:ip6_autottl=-2,3-20:tcp_md5"
      ]
    },
    {
      "name": "http",
      "match": [
        "--filter-tcp=80",
        "--filter-l7=http"
      ],
      "actions": [
        "--out-range=-d10",
        "--payload=http_req",
        "--lua-desync=fake:blob=fake_default_http:ip_autottl=-2,3-20:ip6_autottl=-2,3-20:tcp_md5",
        "--lua-desync=fakedsplit:pos=method+2:ip_autottl=-2,3-20:ip6_autottl=-2,3-20:tcp_md5"
      ]
    },
    {
      "name": "tls",
      "match": [
        "--filter-tcp=443",
        "--filter-l7=tls"
      ],
      "actions": [
        "--out-range=-d10",
        "--payload=tls_client_hello",
        "--lua-desync=fake:blob=sample_tls:ip_autottl=-2,3-20:ip6_autottl=-2,3-20:tcp_md5",
        "--lua-desync=fakedsplit:pos=1:ip_autottl=-2,3-20:ip6_autottl=-2,3-20:tcp_md5"
      ]
    },
    {
      "name": "quic",
      "match": [
        "--filter-udp=443",
        "--filter-l7=quic"
      ],
      "actions": [
        "--payload=quic_initial",
        "--lua-desync=drop"
      ]
    },
    {
      "name": "discord-media",
      "scope": "all",
      "match": [
        "--filter-udp=19294-19344,50000-50100",
        "--filter-l7=discord,stun"
      ],
      "actions": [
        "--out-range=-d10",
        "--payload=stun,discord_ip_discovery",
        "--lua-desync=fake:blob=sample_stun",
        "--lua-desync=fake:blob=sample_discord:repeats=2"
      ]
    }
  ]
}
